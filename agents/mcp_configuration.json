{
  "mcpServers": {
    "pencil": {
      "command": "<caminho_do_executavel_do_pencil>",
      "args": [
        "--app",
        "desktop"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@context7/mcp-server"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  }
}
