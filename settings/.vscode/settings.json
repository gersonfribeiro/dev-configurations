{
  // ==========================================
  // WORKBENCH & INTERFACE
  // Configuracoes de abas, temas e layout da IDE
  // ==========================================
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "Dark Modern",
  "workbench.startupEditor": "none",
  "workbench.tree.renderIndentGuides": "always",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.wrapTabs": true,
  "workbench.editor.pinnedTabsOnSeparateRow": true,

  // ==========================================
  // EDITOR & FORMATTING
  // Salvamento, formatação e ações automáticas
  // ==========================================
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.autoSave": "afterDelay",

  // ESLint 9+ Flat Config — caminho explícito via ESLint class API
  "eslint.options": {
    "overrideConfigFile": "config/eslint.config.js"
  },

  "eslint.validate": [
    "html",
    "css",
    "scss",
    "vue",
    "typescript",
    "javascript",
    "json",
    "jsonc",
    "cjs"
  ],

  // Executa correcoes automaticas do ESLint ao salvar, quando disponiveis.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },

  // Prettier — caminho explícito para o arquivo de config
  "prettier.configPath": "config/prettier.config.cjs",

  // ==========================================
  // LANGUAGE SPECIFIC FORMATTERS
  // Formatadores especificos por linguagem
  // ==========================================

  // Define o Prettier como padrao para arquivos HTML.
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // Define o Prettier como padrao para arquivos CSS.
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // Define o Prettier como padrao para arquivos SCSS.
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // Define o Prettier como padrao para arquivos vue.
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // Define o Prettier como padrao para arquivos TypeScript.
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // Define o Prettier como padrao para arquivos javascript.
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // Define o Prettier como padrao para arquivos cjs.
  "[jsonc, cjs]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // Define o Prettier como padrao para arquivos json.
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },

  // ==========================================
  // IMPORTS & BEHAVIOR
  // Comportamentos automáticos da IDE
  // ==========================================
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "git.openRepositoryInParentFolders": "always",

  // ==========================================
  // AI & COPILOT SETTINGS
  // Configuracoes de assistentes de IA e GitLens
  // ==========================================
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "typescript": false
  },

  // ==========================================
  // EXTENSIONS & OTHERS
  // Extensões, Docker, JSON Schema e domínios
  // ==========================================
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true
  },
}
